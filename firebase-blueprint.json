{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator record keyed by UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private student or administrator profile document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "completedLessonIds": {
          "type": "array",
          "description": "Bounded list of completed lesson IDs (max 100)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "completedLessonIds", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Thematic lesson category such as Psicología, Marketing, or IA",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "slug": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "themeKey": {
          "type": "string",
          "enum": ["psychology", "marketing", "ai", "finance", "design", "leadership"]
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "slug", "description", "themeKey", "authorUid", "createdAt", "updatedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Educational lesson inside a category with video URL or uploaded file, didactic materials, and quiz",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 3000
        },
        "youtubeUrl": {
          "type": "string",
          "maxLength": 500
        },
        "durationMinutes": {
          "type": "number"
        },
        "level": {
          "type": "string",
          "enum": ["Fundamentos", "Intermedio", "Avanzado"]
        },
        "keyTakeaways": {
          "type": "array",
          "description": "Up to 10 key takeaways from the lesson"
        },
        "materials": {
          "type": "array",
          "description": "Up to 15 didactic material items (PDF, video, image, guide)"
        },
        "quizQuestions": {
          "type": "array",
          "description": "Up to 15 quiz questions for applying learned knowledge"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "categoryId",
        "title",
        "description",
        "youtubeUrl",
        "durationMinutes",
        "level",
        "keyTakeaways",
        "materials",
        "quizQuestions",
        "authorUid",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "Reel": {
      "title": "Reel",
      "description": "Short vertical educational video uploaded by an administrator",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "caption": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "fileName": {
          "type": "string",
          "maxLength": 200
        },
        "durationSeconds": {
          "type": "number"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "categoryId",
        "title",
        "caption",
        "videoUrl",
        "fileName",
        "durationSeconds",
        "authorUid",
        "isPublished",
        "createdAt"
      ]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz submission and score record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lessonId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scorePercent": {
          "type": "number"
        },
        "correctCount": {
          "type": "number"
        },
        "totalQuestions": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "lessonId",
        "scorePercent",
        "correctCount",
        "totalQuestions",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup table"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and completed lesson tracking"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Educational categories (Psicología, Marketing, IA, etc.)"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Lessons within categories containing video, didactic materials, and quizzes"
    },
    "/reels/{reelId}": {
      "schema": { "$ref": "#/entities/Reel" },
      "description": "Short vertical educational videos uploaded by administrators"
    },
    "/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Quiz completion records by student"
    }
  }
}
